PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional Nest Observe (leave placeholders if unused)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET

# Newsletter / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="My Diabetes Doc <noreply@example.com>"
NEWSLETTER_UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
